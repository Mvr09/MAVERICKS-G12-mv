# Copy to the application .env; keep real values out of git.
DATABASE_URL=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=15
JEV_MAX_RETRIES=2
JEV_MAX_CONCURRENCY=4
ADMIN_PASSWORD=
SESSION_SECRET=
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=Europe/Madrid
RISK_POLICY_PATH=config/risk_policy.json
RSS_CONFIG_PATH=config/rss_sources.json
RSS_POLL_SECONDS=300
RSS_DAILY_ANALYSIS_BUDGET=100
DEMO_FIXTURES_ENABLED=false
EXPLANATION_PROVIDER=template
# Optional generation: template | ollama | compatible
OLLAMA_BASE_URL=
OLLAMA_MODEL=
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
GENERATOR_MODEL=
# Claude (Anthropic) redacta planes de acción y borradores; nunca decide riesgo, urgencia ni prioridad.
# Sin clave (o LLM_PROVIDER=none) se usan las plantillas. La clave va solo en el entorno o en Railway.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Solo si la clave no pertenece a un workspace (la API pide anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
LLM_TIMEOUT_SECONDS=12
# Railway supplies PORT. Use 8000 locally.
PORT=8000
