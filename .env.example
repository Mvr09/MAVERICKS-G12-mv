# No sobrescribir el .env existente. Variables del backend, nunca VITE_*.
DATABASE_URL=postgresql+psycopg://radar:radar_local_only@localhost:5432/radar
TYPESAFE_API_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=
JEV_MODEL=jev-1.13.0
APP_BASE_URL=http://localhost:8000
RSS_ANALYSIS_ENABLED=false
# Claude (Anthropic) redacta planes de acción y borradores; nunca decide riesgo, urgencia ni prioridad.
# Sin clave (o LLM_PROVIDER=none) se usan las plantillas. La clave va solo en el entorno o en Railway.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Solo si la clave no pertenece a un workspace (la API pide anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
LLM_TIMEOUT_SECONDS=12
PORT=8000
