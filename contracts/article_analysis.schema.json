{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supplier-risk-radar.example/contracts/article-analysis.schema.json",
  "title": "Article analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "article_id",
    "news_id",
    "context_id",
    "analysis_status",
    "is_risk",
    "urgent",
    "affected_supplier_ids",
    "assessments",
    "model_id",
    "question_version",
    "policy_version",
    "error",
    "event_type",
    "evidence",
    "review_reasons"
  ],
  "properties": {
    "article_id": {
      "type": "string"
    },
    "news_id": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "analysis_status": {
      "enum": [
        "done",
        "review",
        "error"
      ]
    },
    "is_risk": {
      "enum": [
        "Y",
        "N",
        null
      ]
    },
    "urgent": {
      "enum": [
        "Y",
        "N",
        null
      ]
    },
    "affected_supplier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supplier_id",
          "p_link",
          "p_risk",
          "p_urgent",
          "is_risk",
          "urgent",
          "severity",
          "priority",
          "priority_band",
          "impact_status",
          "needs_review",
          "review_reasons",
          "evidence_ids",
          "factor_values",
          "policy_version"
        ],
        "properties": {
          "supplier_id": {
            "type": "string",
            "minLength": 1
          },
          "p_link": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p_risk": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p_urgent": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "is_risk": {
            "enum": [
              "Y",
              "N"
            ]
          },
          "urgent": {
            "enum": [
              "Y",
              "N"
            ]
          },
          "severity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "severity_confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "priority_band": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical",
              null
            ]
          },
          "impact_status": {
            "enum": [
              "active",
              "monitoring",
              "resolved",
              "positive",
              "unrelated",
              "unclear"
            ]
          },
          "needs_review": {
            "type": "boolean"
          },
          "review_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "duration_days": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "duration_is_lower_bound": {
            "type": "boolean"
          },
          "factor_values": {
            "type": "object",
            "properties": {
              "C": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "U": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "B": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "G": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "policy_version": {
            "type": "string"
          },
          "p_identity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p_exposure": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p_candidate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "association_status": {
            "enum": [
              "confirmed",
              "review",
              "excluded",
              null
            ]
          },
          "geography_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_policy_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority_requires_review": {
            "type": "boolean"
          },
          "localized_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "human_attention": {
            "enum": [
              "verify_decision",
              "immediate_contact",
              "priority_follow_up",
              "regular_follow_up",
              "none",
              null
            ]
          },
          "exposure_kind": {
            "enum": [
              "reported",
              "identity",
              "potential",
              "unknown",
              "excluded",
              null
            ]
          },
          "requires_pathway_confirmation": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "is_risk": {
                  "const": "N"
                }
              }
            },
            "then": {
              "properties": {
                "urgent": {
                  "const": "N"
                },
                "priority": {
                  "enum": [
                    0,
                    null
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "question_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "enum": [
        "fire_incident",
        "natural_disaster",
        "labour_strike",
        "regulatory_action",
        "export_restriction",
        "financial_distress",
        "quality_recall",
        "logistics_disruption",
        "utility_outage",
        "leadership_change",
        "acquisition",
        "recovery",
        "positive_news",
        "other",
        "not_relevant",
        null
      ]
    },
    "review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "start",
          "end",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "field": {
            "enum": [
              "headline",
              "summary",
              "full_text"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "context_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "summary_only",
            "partial",
            "public_text"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "characters": {
          "type": [
            "integer",
            "null"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "event_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "confidence",
        "taxonomy_version"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "taxonomy_version": {
          "type": "string"
        },
        "label_es": {
          "type": "string"
        }
      }
    },
    "review_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "field",
          "supplier_id",
          "relevance",
          "requires_review",
          "value",
          "threshold"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "supplier_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "relevance": {
            "enum": [
              "association",
              "risk",
              "urgency",
              "priority",
              "auxiliary"
            ]
          },
          "requires_review": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "original_requires_review": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "resolution": {
            "enum": [
              "independent_support_check",
              "factual_basis_check",
              null,
              "model_consistency_check",
              "relational_scope_check"
            ]
          },
          "resolution_hint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review_policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_question_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "matching_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "is_risk": {
            "const": "N"
          }
        }
      },
      "then": {
        "properties": {
          "urgent": {
            "const": "N"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "is_risk": {
            "type": "null"
          },
          "urgent": {
            "type": "null"
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "is_risk": {
            "enum": [
              "Y",
              "N"
            ]
          },
          "urgent": {
            "enum": [
              "Y",
              "N"
            ]
          },
          "error": {
            "type": "null"
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
